# Copy to .env.local and fill in. Names and safe examples only — never real values.
# Full explanation: docs/ENVIRONMENT.md

# The canonical origin for this deployment. Set it per environment so a preview
# build does not emit production canonical URLs.
NEXT_PUBLIC_SITE_URL=https://www.oasismexicankitchenbar.com

# --- Supabase -----------------------------------------------------------------
# Optional. Leave all three blank and the site serves its built-in content and
# works normally; the admin area shows a "not connected yet" message.

# Public by design — this is in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public by design. Constrained by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SECRET. Bypasses Row Level Security. Server-side only.
# Never prefix this with NEXT_PUBLIC_. Mark it Sensitive in your host.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Production always requires sign-in. Only local development may opt out.
ADMIN_REQUIRE_SIGN_IN=true

# Optional, development only. Forces a seasonal theme on regardless of the
# admin setting, e.g. OASIS_THEME_FORCE=halloween-dotd. Ignored in production.
# OASIS_THEME_FORCE=

# --- Ticketing ----------------------------------------------------------------
# Vercel sends this with every cron request. Any long random string.
CRON_SECRET=

# --- Stripe -------------------------------------------------------------------
# Secret key: server-side only. Publishable key: in the browser bundle by design.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From the webhook endpoint in the Stripe Dashboard (docs/stripe-setup.md).
STRIPE_WEBHOOK_SECRET=
# 32+ random bytes, base64 or hex. Signs QR payloads and ticket-page links.
TICKET_SIGNING_SECRET=

# --- Email (docs/email-system.md) ---------------------------------------------
# Sending needs the first two. Emailing GUESTS additionally needs the switch.
RESEND_API_KEY=
# A real address on the domain verified in Resend. @resend.dev is refused.
ORDERS_FROM_EMAIL=tickets@tickets.oasismexicankitchenbar.com
# Optional. Default "Oasis Mexican Kitchen & Bar".
# EMAIL_FROM_NAME=
# Recommended: a mailbox a person reads. Shown in the footer as the support address.
# EMAIL_REPLY_TO=
# Where disputes, failed refunds, oversells and cancellations are reported.
OWNER_ALERT_EMAIL=
# THE SWITCH. Only `true` lets tickets, reminders, refunds and event changes
# reach guests. Deploying the code does not send email; this does.
EMAIL_DELIVERY_ENABLED=false
# Optional, staging only: every guest email goes here instead of to the guest.
# EMAIL_REDIRECT_ALL_TO=
# Optional: which ticket-confirmation design to send: pass (default), editorial, poster.
# EMAIL_TICKET_DIRECTION=pass
# From the Resend webhook (…/api/webhooks/resend). Lets Oasis record delivered/bounced.
RESEND_WEBHOOK_SECRET=
# From Supabase → Authentication → Hooks → Send Email (…/api/webhooks/supabase-auth).
# Turns staff invitations and sign-in links into branded Oasis emails.
SUPABASE_AUTH_HOOK_SECRET=
